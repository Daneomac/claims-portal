# Local development configuration for docker compose.
#
#   cp .env.example .env
#
# These values are for a throwaway local stack only. .env is git-ignored;
# never commit real credentials. In a deployed environment these come from
# a secrets manager.

# PostgreSQL superuser (used only by the init script to create service databases)
POSTGRES_PASSWORD=local-only-postgres

# One database and one login per service (least privilege)
CLAIMS_DB_PASSWORD=local-only-claims
NOTIFICATIONS_DB_PASSWORD=local-only-notifications

# RabbitMQ application user
RABBITMQ_USER=claims-portal
RABBITMQ_PASSWORD=local-only-rabbitmq
